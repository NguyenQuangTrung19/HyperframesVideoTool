# ════════════════════════════════════════════════════════════════════════════
# Auto-Create-Video — Environment Configuration
# ════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your real API keys.
# .env.local is gitignored — never commit real keys.

# ── TTS Provider ────────────────────────────────────────────────────────────
# Choose ONE: vieneu | ausynclab
# - vieneu    : runs locally via Python — no API key, no quota, offline
# - ausynclab : ausynclab.io — large Vietnamese voice library, requires paid plan;
#               foreign names (Mbappe, Dembele, Bernabeu) read better WITHOUT diacritics
TTS_PROVIDER=vieneu

# ════════════════════════════════════════════════════════════════════════════
# OPTION 1 (DEFAULT): VieNeu-TTS  (https://github.com/pnnbao97/VieNeu-TTS)
# ════════════════════════════════════════════════════════════════════════════
# Local Python TTS — no API key, no internet required after first model download.
#
# Setup (one-time):
#   1) Install uv:    powershell -c "irm https://astral.sh/uv/install.ps1 | iex"
#   2) Clone:         git clone https://github.com/pnnbao97/VieNeu-TTS.git
#                     (recommended: place it next to this repo as a sibling dir)
#   3) Install deps:  cd VieNeu-TTS && uv sync
#   4) CPU pre-built llama-cpp (Windows only, much faster than building):
#                     uv pip install llama-cpp-python --extra-index-url \
#                       https://pnnbao97.github.io/llama-cpp-python-v0.3.16/cpu/

# Absolute path to the cloned VieNeu-TTS repo. If left blank, defaults to
# `<this-repo>/../VieNeu-TTS` (sibling directory layout).
# VIENEU_PROJECT_DIR=C:/Users/you/Workspace/Projects/VieNeu-TTS

# Preset voice id. Run `tts.list_preset_voices()` in the VieNeu repo to see all.
# Available: Binh (nam Bắc), Tuyen (nam Bắc), Vinh (nam Nam), Doan (nữ Nam),
#            Ly (nữ Bắc), Sơn (nam Nam), Ngoc (nữ Bắc).
# Default Binh = Thanh Bình, nam miền Bắc, fast pace — fits SportsForAllTV shorts.
VIENEU_VOICE_ID=Binh

# "natural" (default — conversational) or "storytelling" (slower, narrative).
VIENEU_EMOTION=natural

# Optional override for the uv binary path. If unset, the pipeline probes
# `~/.local/bin/uv(.exe)` and falls back to `uv` on PATH.
# UV_BIN=C:/Users/you/.local/bin/uv.exe

# ════════════════════════════════════════════════════════════════════════════
# OPTION 2: AusyncLab.io  (https://ausynclab.io)
# ════════════════════════════════════════════════════════════════════════════
# Paid Vietnamese TTS — large voice library + voice cloning from 3-10s sample.
# Setup: sign up → buy a plan (free tier returns 403 paid_plan_only on TTS) →
# go to /voices, click "Use" on a voice → copy the numeric ID it gets in your
# account. The public library is NOT browsable via API; voices must be adopted
# via the website first.
AUSYNCLAB_API_KEY=ak_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUSYNCLAB_VOICE_ID=1234567

# Model — myna-1-turbo is the API default and the cleanest match for VN news
# narration (faster, ~25% shorter duration vs myna-2). myna-1 = original, myna-2 = newest.
AUSYNCLAB_MODEL_NAME=myna-1-turbo
# Speech rate — actually a DURATION multiplier (verified empirically): lower
# value = faster reading, higher = slower. Range 0.75–1.25, default 1.0.
# For VN news narration with myna-1-turbo, 1.10–1.20 reads at a natural pace.
AUSYNCLAB_SPEED=1.0

# Optional overrides
AUSYNCLAB_BASE_URL=https://api.ausynclab.io/api/v1
AUSYNCLAB_POLL_INTERVAL_MS=2000
AUSYNCLAB_POLL_TIMEOUT_MS=180000

# OPTION 3: FPT.AI TTS  (https://fpt.ai/tts) — cheap Vietnamese, pay-per-character.
#   Set TTS_PROVIDER=fptai. Get an api_key at https://console.fpt.ai (Text to Speech app).
FPTAI_API_KEY=your_fpt_api_key
# Voice: leminh (male North, news) | banmai / thuminh (female North) |
#        giahuy (male South) | lannhi / myan (female South) | linhsan
FPTAI_VOICE=leminh
# speed: -3..3, 0 = normal, positive = faster
FPTAI_SPEED=0
# Optional overrides
FPTAI_BASE_URL=https://api.fpt.ai
FPTAI_POLL_INTERVAL_MS=3000
FPTAI_POLL_TIMEOUT_MS=180000

# OPTION 4: VBee AIVoice  (https://aivoice.vbee.vn) — most natural Vietnamese voices, pay-per-use.
#   Set TTS_PROVIDER=vbee. Get access token + app id from the VBee dashboard (API section).
VBEE_ACCESS_TOKEN=your_vbee_access_token
VBEE_APP_ID=your_vbee_app_id
# voice_code is a long string — copy the exact one from the VBee dashboard.
VBEE_VOICE_CODE=hn_male_manhdung_news_48k-fhg
# speed_rate as a string: "1.0" normal, "1.1" faster, "0.9" slower
VBEE_SPEED_RATE=1.0
# Optional overrides
VBEE_BITRATE=128
VBEE_BASE_URL=https://vbee.vn/api/v1
VBEE_POLL_INTERVAL_MS=3000
VBEE_POLL_TIMEOUT_MS=180000

# OPTION 5: MANUAL  — supply a pre-recorded voiceover file instead of any API.
#   Temporary fallback when paid credit (e.g. VBee) is exhausted. Set
#   TTS_PROVIDER=manual, then drop ONE file holding the full voiceover next to
#   script.json named voice-source.<ext> (mp4/m4a/mp3/wav/aac/ogg), OR set
#   VOICE_FILE to its absolute path. The pipeline converts it to voice/full.mp3
#   and uses local faster-whisper alignment to split it per scene (no API, free).
#   TTS_PROVIDER=manual
#   VOICE_FILE=

# ════════════════════════════════════════════════════════════════════════════
# PODCAST PIPELINE TTS OVERRIDE
# ════════════════════════════════════════════════════════════════════════════
# `/create-podcast` lets you pick a different TTS provider than the
# global TTS_PROVIDER (which stays on VieNeu for motion-graphic clips).
# Why: podcast-clip format = voice IS the product, and VieNeu's emotion is
# too flat — set this to ausynclab or elevenlabs for a more human voice
# while keeping /create-video on free local VieNeu.
#
# Allowed: ausynclab | elevenlabs | vieneu | (unset → auto-detect or fall
# back to global TTS_PROVIDER). When unset and ElevenLabs creds are present,
# ElevenLabs is auto-selected.
# PODCAST_TTS_PROVIDER=ausynclab

# ── Per-pipeline AusyncLab overrides (when PODCAST_TTS_PROVIDER=ausynclab) ──
# Lets the podcast pipeline use a DIFFERENT voice + speed than /create-video,
# without per-run env juggling. Both fall back to the AUSYNCLAB_VOICE_ID /
# AUSYNCLAB_SPEED above when unset.
# PODCAST_AUSYNCLAB_VOICE_ID=1914691     # podcast-only voice (numeric ID)
# PODCAST_AUSYNCLAB_SPEED=1.05            # podcast-only speed (same duration-multiplier semantics)

# ── For PODCAST_TTS_PROVIDER=elevenlabs (or auto if creds set) ──────────────
# Sign up at https://elevenlabs.io (Free 10k chars/mo, Starter $5 ~30k,
# Creator $22 ~100k, voice cloning needs paid plan).
# (Optional) Clone your voice: Voices → Add → Instant Voice Clone → upload
# 1 min of clean speech → copy the resulting voice ID.
# Or pick a stock VN voice at https://elevenlabs.io/app/voice-library.
# ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ELEVENLABS_VOICE_ID=XXXXXXXXXXXXXXXXXXXX
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_ENDPOINT=https://api.elevenlabs.io/v1
# Optional voice tuning (0.0 – 1.0). Defaults: 0.5 / 0.75 / 0.0 / true.
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY_BOOST=0.75
# ELEVENLABS_STYLE=0.0
# ELEVENLABS_SPEAKER_BOOST=true

# ════════════════════════════════════════════════════════════════════════════
# Background music for /create-video (optional)
# ════════════════════════════════════════════════════════════════════════════
# Drop royalty-free tracks into assets/music/ and every render picks one at
# random, loops it to length, and ducks it ~6 dB under the narration.
# Empty folder = no music (default state). READ assets/music/README.md before
# adding anything — assets/beat/ contains commercial tracks that WILL get
# copyright-claimed; do not copy those here.
#
# VIDEO_BG_MUSIC=              # set-but-empty -> music OFF
# VIDEO_BG_MUSIC=calm.mp3      # pin one track from assets/music/
# VIDEO_BG_MUSIC=C:/beds/x.mp3 # pin a file anywhere on disk
# Volume before ducking. Default 0.22 = bed 14 dB under the voice (channel owner's
# deliberate pick; broadcast norm is 15-20). Above 0.22 masks Vietnamese tail
# consonants (-ng, -nh, -n, -m), the same failure that capped SFX at 0.22.
# VIDEO_BG_MUSIC_VOLUME=0.22

# ════════════════════════════════════════════════════════════════════════════
# TikTok follow card (outro)
# ════════════════════════════════════════════════════════════════════════════
# Customize the TikTok-style profile card that appears at the end of every video.
# All fields optional — defaults work out of the box.
TIKTOK_DISPLAY_NAME=SportsForAllTV
TIKTOK_HANDLE=@bonglan0702
TIKTOK_FOLLOWERS=1.2M followers

# Optional: URL to your real TikTok avatar image (jpg/png, square, ~256x256+).
# If not set, uses the bundled default avatar at assets/logoTV.png.
# You can also replace assets/logoTV.png directly with your own image.
# TIKTOK_AVATAR_URL=https://example.com/your-avatar.jpg

# ════════════════════════════════════════════════════════════════════════════
# AI scene image generation (optional — gradient fallback if not set)
# ════════════════════════════════════════════════════════════════════════════
# When enabled, the pipeline generates an illustrative background for scenes
# with templates: hook (only if no og:image), callout, stat-hero. Images are
# saved to video/output/<slug>/images/<sceneId>-<hash>.png and reused on rerender.
#
# Only triggers for scenes that include an `imagePrompt` field in script.json.

# Choose provider:
#   - "openai" (paid, photo-realistic, gpt-image-1)
#   - "gemini" (free tier on AI Studio, ~1500 req/day, decent quality)
#   - "xai"    (paid, Grok Imagine — strong on action/sports photography,
#              native 9:16 support, requires API credits at console.x.ai)
# Default: openai.
IMAGE_PROVIDER=gemini

# ── Option A: OpenAI gpt-image-1 (paid) ─────────────────────────────────────
# Get an API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_IMAGE_MODEL=gpt-image-1
# IMAGE_QUALITY: low (~$0.011), medium (~$0.04, recommended), high (~$0.17), auto
IMAGE_QUALITY=medium

# ── Option B: Google Gemini (free tier — recommended for demos) ─────────────
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── Option C: xAI Grok Imagine (paid — best for sports/action photography) ──
# IMPORTANT: this is xAI API credits, NOT the SuperGrok / X Premium chat sub.
# Buy credits at https://console.x.ai → API Keys → create key → Credits → top up.
# Pricing is flat per-image; "grok-imagine-image-quality" is recommended.
XAI_API_KEY=xai-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
XAI_IMAGE_MODEL=grok-imagine-image-quality
# 1k = ~768x1344 (cheaper, fine for Shorts), 2k = ~1536x2688 (sharper)
XAI_IMAGE_RESOLUTION=1k

# ── Pipeline tuning ─────────────────────────────────────────────────────────
# TTS_CONCURRENCY: 1 for VieNeu (single Python worker) or AusyncLab (API limit).
# 4 works well for AusyncLab paid plan — cuts the TTS step ~4x with no rate-limit
# issues. Keep 1 for VieNeu (local Python worker, single-threaded).
TTS_CONCURRENCY=4

# Hyperframes render workers — "auto" lets calibration decide (often drops to 1
# worker on heavy compositions, very slow). Forcing 4 cuts render ~25% on a
# multi-core machine, no OOM. Use "auto" only if Chrome processes get killed.
HYPERFRAMES_WORKERS=4

# Hyperframes GPU encode (NVENC) for the ffmpeg step. Requires NVIDIA driver
# >= 570.0. Falls back to libx264 if false. Toggle true only after verifying
# `nvidia-smi` shows driver 570+ and `ffmpeg -encoders | grep nvenc` lists it.
HYPERFRAMES_GPU=false

# ════════════════════════════════════════════════════════════════════════════
# Music video pipeline (`/create-music-video`)
# ════════════════════════════════════════════════════════════════════════════
# Builds 9:16 lyric-karaoke videos from a song + footage. Music alignment is
# harder than TTS — defaults use medium Whisper model; bump to large-v3 if
# alignment is off.
# MUSIC_ALIGN_LANG=vi
# MUSIC_ALIGN_MODEL=medium
# MUSIC_CAPTION_FONT=Arial Black
# MUSIC_CAPTION_FONTSIZE=84
# MUSIC_CAPTION_WINDOW=5
# MUSIC_CAPTION_Y=0.62
# MUSIC_CAPTION_ACTIVE_COLOR=FFFF00
# MUSIC_CAPTION_BASE_COLOR=FFFFFF
# MUSIC_FPS=30
# MUSIC_CRF=20
# MUSIC_PRESET=medium
